{
  "name": "jutilities",
  "version": "1.2.0",
  "description": "Small, typed, extensively documented TypeScript utilities for Node.js and Browser: caching, retries, timeouts, delays, abort-aware sleeps, streams, super-JSON serialization, hashing, and type guards. Subpath imports: no barrel, every utility is jutilities/<module>.",
  "keywords": [
    "utilities",
    "utils",
    "typescript",
    "nodejs",
    "browser",
    "cache",
    "memoize",
    "retry",
    "timeout",
    "sleep",
    "abort-signal",
    "json",
    "superjson",
    "serialization",
    "streams",
    "base64",
    "hash",
    "type-guards"
  ],
  "exports": {
    "./*": "./dist/*.js"
  },
  "homepage": "https://github.com/rayenboussayed/jutilities#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayenboussayed/jutilities.git"
  },
  "bugs": {
    "url": "https://github.com/rayenboussayed/jutilities/issues"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run examples",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache --max-warnings 0",
    "build": "tsc -p tsconfig.build.json",
    "examples": "npm run build && node --import tsx examples/run-all.ts",
    "prepare": "husky && node scripts/link-self.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@deslint/eslint-plugin": "^0.10.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-de-morgan": "^2.3.0",
    "eslint-plugin-jsdoc": "^65.3.8",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "expired-map": "^1.0.0"
  }
}
