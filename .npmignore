# jutilities — publish exclusions (defense-in-depth on top of the `files` whitelist).
# The `files` field in package.json (dist, docs, examples, README.md) is the
# primary inclusion list; everything below is what must NEVER reach the
# tarball, even if that whitelist loosens later.

# ---- sources & internals (compiled dist/ ships instead) ----
src/
coverage/
.nyc_output/

# ---- tests (live in src/, are run from the repo, not from node_modules) ----
*.test.ts

# ---- dev tooling & build configs ----
eslint.config.*
tsconfig*.json
*.tsbuildinfo
scripts/

# ---- git hooks (repo tooling; regenerated by `npm run prepare`) ----
.husky/

# ---- editor / VCS / CI noise ----
.kotlin/
.cursor/
.vscode/
.idea/
.github/
.travis.yml
.DS_Store
Thumbs.db
.gitignore

# ---- secrets & environment ----
.env*
*.pem
*.key

# ---- local state, lockfiles & debug logs ----
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tgz
