# jutilities — git exclusions.
# Publish-time filtering is separate: see `files` in package.json and .npmignore.

# ---- dependencies ----
node_modules/

# ---- build outputs ----
dist/
*.tsbuildinfo

# ---- coverage & test artifacts ----
coverage/
.nyc_output/

# ---- environment & secrets ----
.env
.env.*
*.pem
*.key

# ---- logs & debug state ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# ---- pack artifacts ----
*.tgz

# ---- editors & OS noise ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- husky helper scripts (regenerated by `npm run prepare`) ----
.husky/_
